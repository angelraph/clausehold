# Which NEAR network clauses are written to.
# testnet -> free; funding is a direct ft_transfer of a test token
# mainnet -> real funds; funding goes through NEAR Intents (1Click), which has no testnet
CLAUSEHOLD_NETWORK=testnet

# The factory contract that creates one sub-account per clause.
# Defaults to clausehold.testnet or clausehold.near for the chosen network.
CLAUSEHOLD_FACTORY_ACCOUNT=
# Optional RPC override. Leave blank to use the network default.
CLAUSEHOLD_NEAR_RPC_URL=

# NEAR AI Cloud (OpenAI-compatible). Used to compile a plain-English mandate and
# to write a note explaining a delivery. It never authorizes or releases money.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=

# Local API server.
CLAUSEHOLD_API_PORT=4477
# Leave blank for local development. Set it before exposing the API on a public
# host, since every request then needs a matching X-Clausehold-Api-Key header.
CLAUSEHOLD_API_KEY=
# Set to true to refuse the shared key above and accept only agents registered
# with `clausehold agent add`, each with its own key bound to specific mandates.
CLAUSEHOLD_REQUIRE_AGENT_KEYS=false
# A different credential, for deciding rather than proposing: approve, reject,
# halt, resume. Agents must not hold it. If unset, those endpoints are disabled
# and decisions are made through the CLI.
CLAUSEHOLD_APPROVER_KEY=
# How long an escalated clause waits for a second person before it expires.
CLAUSEHOLD_APPROVAL_TTL_MINUTES=10

# Local mirror of on-chain events, hash-chained.
CLAUSEHOLD_AUDIT_LOG_PATH=./data/audit.log.jsonl
CLAUSEHOLD_MANDATES_DIR=./data/mandates

# Demo accounts used by `npm run studio-agent`.
CLAUSEHOLD_STUDIO_ACCOUNT=studio-agent.testnet
CLAUSEHOLD_EDITOR_ACCOUNT=editor.testnet
